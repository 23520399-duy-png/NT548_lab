# API Gateway: phục vụ giao diện tĩnh + chuyển tiếp /api/* tới các microservice.
# Biến ${PRODUCT_SERVICE_URL}, ${ORDER_SERVICE_URL} được envsubst thay lúc container khởi động.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"gateway"}';
    }

    location /api/products {
        proxy_pass ${PRODUCT_SERVICE_URL}/products;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location /api/orders {
        proxy_pass ${ORDER_SERVICE_URL}/orders;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
