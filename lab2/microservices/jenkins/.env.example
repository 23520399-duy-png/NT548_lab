# Copy thành .env:  cp .env.example .env   (scripts/setup.sh tự điền SONAR_TOKEN, DOCKER_GID)
# KHÔNG commit file .env (đã có trong .gitignore)

# Tài khoản quản trị Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=ChangeMe_Jenkins123!

# Mật khẩu mới cho user admin của SonarQube (mặc định ban đầu admin/admin)
SONAR_ADMIN_PASSWORD=ChangeMe_Sonar123!

# Repo GitHub chứa mã nguồn (repo private -> cần Personal Access Token quyền đọc "Contents")
GITHUB_REPO_URL=https://github.com/23520399-duy-png/NT548_lab.git
GITHUB_BRANCH=main
GITHUB_USER=23520399-duy-png
GITHUB_TOKEN=

# Tự sinh bởi scripts/setup.sh
SONAR_TOKEN=
DOCKER_GID=
