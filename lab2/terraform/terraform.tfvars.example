# Copy thành terraform.tfvars rồi sửa:  cp terraform.tfvars.example terraform.tfvars
# Lấy IP public của bạn:                curl -s https://checkip.amazonaws.com
# (GitHub Actions KHÔNG dùng file này – biến được truyền qua GitHub Secrets/Variables)

aws_region           = "us-east-1"
project_name         = "nt548-lab02"
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24"]
private_subnet_cidrs = ["10.0.2.0/24"]
allowed_ssh_cidr     = "203.0.113.10/32" # <-- THAY bằng IP của bạn + /32
instance_type        = "t3.micro"
key_name             = "vockey"
iam_instance_profile = "LabInstanceProfile"
enable_flow_logs     = true
